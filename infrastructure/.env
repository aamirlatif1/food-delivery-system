# Docker Compose project name (prefix for containers and networks)
COMPOSE_PROJECT_NAME=food-delivery

# Kafka (KRaft, no ZooKeeper)
KAFKA_IMAGE=apache/kafka:4.3.1
# Generate a new one with: docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
# Changing it requires wiping ./volumes/kafka/*
KAFKA_CLUSTER_ID=Kh4VE4kDTRWX2-pFnnyrwQ
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

# Host ports, one per broker (bootstrap from the host: localhost:9092,localhost:9094,localhost:9096)
KAFKA_1_HOST_PORT=9092
KAFKA_2_HOST_PORT=9094
KAFKA_3_HOST_PORT=9096

# Topic defaults (REQUIREMENTS.md §5.1)
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2

# Kafka UI
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.3.0
KAFKA_UI_HOST_PORT=8080
